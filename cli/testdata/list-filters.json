{
    "about": "What `books <resource> list <args>` sends as the filter and sort query values. cli/list_filters_test.go holds the command to these texts; server/cli_resources_test.go sends the same texts to the real PocketBase API. Edit a text here only after changing list.go on purpose.",
    "cases": [
        {
            "name": "accounts-default",
            "resource": "accounts",
            "args": [],
            "filter": "inactive = false",
            "sort": "full_name,id"
        },
        {
            "name": "accounts-type-and-search",
            "resource": "accounts",
            "args": ["--type", "bank", "--search", "petty"],
            "filter": "inactive = false && type = \"bank\" && (name ~ \"petty\" || number ~ \"petty\")",
            "sort": "full_name,id"
        },
        {
            "name": "accounts-search-quote",
            "resource": "accounts",
            "args": ["--search", "x\" || id != \""],
            "filter": "inactive = false && (name ~ \"x\\\" || id != \\\"\" || number ~ \"x\\\" || id != \\\"\")",
            "sort": "full_name,id"
        },
        {
            "name": "accounts-search-percent",
            "resource": "accounts",
            "args": ["--search", "15%"],
            "filter": "inactive = false && (name ~ \"15\\\\%\" || number ~ \"15\\\\%\")",
            "sort": "full_name,id"
