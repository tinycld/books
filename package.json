{
    "name": "@tinycld/books",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Double-entry bookkeeping and accounting.",
    "exports": {
        "./package.json": "./package.json",
        "./manifest": "./manifest.ts",
        "./types": "./tinycld/books/types.ts",
