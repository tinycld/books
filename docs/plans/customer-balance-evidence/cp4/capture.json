{
    "outDir": ".",
    "widths": [390, 1280],
    "shots": [
        {
            "name": "filtered",
            "url": "/a/reports?package=books",
            "actions": [
                { "idFromText": "Customer Balance", "goto": "/a/reports/$urlId" },
                { "waitFor": "report-table" },
                { "click": "report-add-filter" },
                { "click": "report-add-filter-customers" },
                { "waitFor": "report-filter-options" },
                { "fill": "report-filter-search", "value": "Harborview" },
                { "click": "report-filter-group-Harborview Hospitality Group" },
                { "click": "report-filter-apply" },
                { "waitFor": "Customer: All Harborview Hospitality Group sub-customers" },
                { "click": "report-param-customers" },
                { "waitFor": "report-filter-options" },
                { "fill": "report-filter-search", "value": "Aspen Ridge" },
                { "clickText": "Aspen Ridge Dental" },
                { "click": "report-filter-apply" },
                { "waitForHidden": "report-filter-picker" },
                {
                    "waitFor": "Customer: Aspen Ridge Dental, All Harborview Hospitality Group sub-customers"
                },
                { "pause": 1500 }
            ]
        }
    ]
}
