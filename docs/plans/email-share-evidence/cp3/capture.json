        {
            "url": "/a/books/customers",
            "ready": "pkg-active-books",
            "hideLabels": ["New"],
            "name": "send-long",
            "height": 900,
            "schemes": ["light"],
            "actions": [
                {
                    "search": "Seed invoice posted",
                    "pick": "^Invoice \\d+ · "
                },
                {
                    "waitFor": "invoice-read-actions"
                },
                {
                    "press": "s"
                },
                {
                    "waitFor": "document-send-body"
                },
                {
                    "fill": "document-send-to",
                    "value": "theodore.okonkwo-lindqvist@stjudecommunityhospitalfoundation.org"
                },
                {
                    "fill": "document-send-subject",
                    "value": "Invoice 1003 from Hartwell Regional Industrial Supply and Fastener Distribution Partners of North Texas, Incorporated"
                },
                {
                    "editIn": "document-send-body"
                },
                {
                    "press": "ControlOrMeta+a"
                },
                {
                    "type": "Hello St. Jude Community Hospital Foundation of the Greater Willamette Valley,"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "Attached is invoice 1003 from Hartwell Regional Industrial Supply and Fastener Distribution Partners of North Texas, Incorporated."
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "Annex network refresh, October visit. Parts are billed at cost plus ten percent; labor & travel are billed at the agreed rate."
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "View this invoice online: https://books.hartwell.example/p/books/invoices/pub_invoice1003_000000000000000000000000000000"
                },
                {
                    "clickText": "Send invoice 1003"
                }
            ],
            "widths": [390]
        },
