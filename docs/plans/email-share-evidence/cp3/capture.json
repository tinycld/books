        {
            "url": "/a/books/customers",
            "ready": "pkg-active-books",
            "hideLabels": ["New"],
            "name": "send-formatted",
            "height": 900,
            "schemes": ["light"],
            "actions": [
                {
                    "search": "Seed invoice posted",
                    "pick": "^Invoice \\d+ · "
                },
                {
                    "waitFor": "invoice-read-actions"
                },
                {
                    "press": "s"
                },
                {
                    "waitFor": "document-send-body"
                },
                {
                    "editIn": "document-send-body"
                },
                {
                    "press": "ControlOrMeta+a"
                },
                {
                    "type": "Hello Harborview Hospitality Group,"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "Attached is invoice 1003. "
                },
                {
                    "press": "ControlOrMeta+b"
                },
                {
                    "type": "Please note the new bank details"
                },
                {
                    "press": "ControlOrMeta+b"
                },
                {
                    "type": " before you pay; the "
                },
                {
                    "press": "ControlOrMeta+i"
                },
                {
                    "type": "old account closes"
                },
                {
                    "press": "ControlOrMeta+i"
                },
                {
                    "type": " on "
                },
                {
                    "press": "ControlOrMeta+u"
                },
                {
                    "type": "Nov 30, 2026"
                },
                {
                    "press": "ControlOrMeta+u"
                },
                {
                    "type": "."
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "What this invoice covers:"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "- October catch-up bookkeeping"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "Wi-Fi refresh for the front office, six access points"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "One on-site visit"
                },
                {
                    "press": "Enter"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "To pay:"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "1. Open the invoice online."
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "Use the reference number 1003 on your transfer."
                },
                {
                    "press": "Enter"
                },
                {
                    "press": "Enter"
                },
                {
                    "type": "> We moved our accounts to First Prairie Bank on Nov 1. Payments to the old account are returned."
                },
                {
                    "clickText": "Send invoice 1003"
                }
            ],
            "widths": [390]
        },
