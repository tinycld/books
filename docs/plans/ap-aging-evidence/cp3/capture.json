{
    "outDir": ".",
    "shots": [
        {
            "name": "populated",
            "url": "/a/reports?package=books",
            "ready": "reports-hub",
            "widths": [1280, 1024],
            "height": 1800,
            "actions": [
                { "clickText": "A/P Aging" },
                { "waitFor": "report-table" },
                { "pause": 1500 }
            ]
        },
        {
            "name": "opened",
            "url": "/a/reports?package=books",
            "ready": "reports-hub",
            "widths": [1280, 1024],
            "height": 2300,
            "actions": [
                { "clickText": "A/P Aging" },
                { "waitFor": "report-table" },
                { "clickText": "Harbor Freight Logistics" },
                { "waitFor": "report-table" },
                { "pause": 1500 }
            ]
        },
        {
            "name": "item-opened",
            "url": "/a/reports?package=books",
            "ready": "reports-hub",
            "widths": [1280, 1024],
            "height": 2800,
            "actions": [
                { "clickText": "A/P Aging" },
                { "waitFor": "report-table" },
                { "clickText": "Harbor Freight Logistics" },
                { "waitFor": "report-table" },
                { "pause": 1500 },
                { "clickPattern": "^Bill \\d+$" },
                { "waitFor": "report-table" },
                { "pause": 1500 }
            ]
        },
        {
            "name": "by-balance",
            "url": "/a/reports?package=books",
            "ready": "reports-hub",
            "widths": [1280],
            "height": 1500,
            "actions": [
                { "clickText": "A/P Aging" },
                { "waitFor": "report-table" },
                { "click": "report-param-order" },
                { "clickRole": "radio", "name": "Largest balance" },
                { "waitForHidden": "report-filter-picker" },
                { "pause": 2000 }
            ]
        },
        {
            "name": "filtered",
            "url": "/a/reports?package=books",
            "ready": "reports-hub",
            "widths": [1280],
            "actions": [
                { "clickText": "A/P Aging" },
                { "waitFor": "report-table" },
                { "click": "report-add-filter" },
                { "click": "report-add-filter-vendors" },
                { "fill": "report-filter-search", "value": "Harbor Freight" },
                { "clickRole": "checkbox", "name": "Harbor Freight Logistics" },
                { "fill": "report-filter-search", "value": "Pacific Power" },
                { "clickRole": "checkbox", "name": "Pacific Power" },
                { "click": "report-filter-apply" },
                { "waitForHidden": "report-filter-picker" },
                { "waitFor": "report-header-param-vendors" },
                { "pause": 2000 }
            ]
        },
        {
            "name": "past-day",
            "url": "/a/reports?package=books",
            "ready": "reports-hub",
            "widths": [1280],
            "height": 1500,
            "actions": [
                { "clickText": "A/P Aging" },
                { "waitFor": "report-table" },
                { "click": "report-param-asOf" },
                { "fill": "report-period-as-of", "value": "2026-10-15" },
                { "press": "Escape" },
                { "waitForTextIn": "report-document-period", "text": "As of October 15, 2026" },
                { "click": "report-document-period" },
                { "pause": 1500 }
            ]
        },
        {
            "name": "empty",
            "url": "/a/reports?package=books",
            "ready": "reports-hub",
            "widths": [1024],
            "actions": [
                { "clickText": "A/P Aging" },
                { "waitFor": "report-table" },
                { "click": "report-param-asOf" },
                { "fill": "report-period-as-of", "value": "2020-01-01" },
                { "press": "Escape" },
                { "waitFor": "report-empty" },
                { "waitForTextIn": "report-document-period", "text": "As of January 1, 2020" },
                { "click": "report-document-period" }
            ]
        }
    ]
}
