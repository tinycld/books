{
    "outDir": ".",
    "shots": [
        {
            "name": "void",
            "widths": [1280],
            "url": "/a/books/expenses/new",
            "ready": "expense-form",
            "hideLabels": ["New"],
            "height": 1000,
            "actions": [
                { "click": "form-input-vendor" },
