                { "waitFor": "expense-read-only" },
                { "waitFor": "expense-posted-by" },
                { "pause": 500 },
                { "click": "expense-read-void" },
                { "waitFor": "void-dialog" },
                { "click": "void-confirm" },
                { "waitFor": "expense-voided-by" },
                { "pause": 500 }
            ]
        },
        {
