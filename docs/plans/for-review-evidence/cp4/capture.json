                        "can_write": false,
                        "is_admin": false
                    }
                ]
            },
            "actions": [
                { "clickText": "1000 Business Checking" },
                { "waitFor": "bank-tab-body-review" },
                { "waitFor": "bank-review-cards" },
                { "clickText": "CHECK 1050" },
                { "waitFor": "bank-txn-drawer" },
                { "waitFor": "bank-txn-field-check" },
