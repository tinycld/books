            },
            "actions": [
                { "clickText": "1000 Business Checking" },
                { "waitFor": "bank-tab-body-review" },
                { "waitFor": "bank-review-cards" },
                { "clickNth": "bank-review-check-", "index": 0 },
                { "clickNth": "bank-review-check-", "index": 1 },
                { "clickNth": "bank-review-check-", "index": 2 },
                { "waitFor": "bank-review-exclude" },
                { "click": "bank-review-exclude" },
                { "waitFor": "bank-review-result" },
                { "waitFor": "bank-review-selection" }
            ]
        },
        {
            "name": "done",
            "url": "/a/books/banking",
            "ready": "bank-tabs-review",
            "writes": { "collection": "books_bank_transactions", "answers": ["ok", "ok", "ok"] },
            "actions": [
                { "clickText": "1000 Business Checking" },
                { "waitFor": "bank-tab-body-review" },
                { "waitFor": "bank-review-cards" },
                { "clickNth": "bank-review-check-", "index": 0 },
                { "clickNth": "bank-review-check-", "index": 1 },
                { "clickNth": "bank-review-check-", "index": 2 },
                { "waitFor": "bank-review-exclude" },
                { "click": "bank-review-exclude" },
                { "waitFor": "bank-review-result" },
                { "waitForHidden": "bank-review-selection" }
            ]
        },
        {
            "name": "excluded-selected",
            "url": "/a/books/banking",
            "ready": "bank-tabs-review",
