node_modules/
*.tsbuildinfo
.DS_Store
# Linked-sibling packages must never ship a lockfile — peer deps
# resolve through the app shell's install. Ignore all common lockfiles
# in case `pnpm install` (or any other PM) accidentally runs here.
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lock
# Per-member Go workspace, written by the app shell's generator on every
# install so this module resolves tinycld.org/core when built on its own.
/server/go.work
/server/go.work.sum
